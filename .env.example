# SAAMEK Frontend Environment Variables Configuration
# Copy this file to .env to configure your local keys.

# 1. Google Maps JavaScript API Key (Used for real interactive satellite map)
# Get a key from https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# 2. NASA FIRMS API Key (Used for real satellite thermal fire detections)
# Request a free map key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_NASA_FIRMS_API_KEY=

# 3. OpenAQ API Key (Optional, for air quality monitoring stations feed)
# Request a free key from https://openaq.org
VITE_OPENAQ_API_KEY=
